#!/bin/bash

set -e

NGINX_CLIENT_MAX_BODY_SIZE="${NGINX_CLIENT_MAX_BODY_SIZE:-1m}"
if [[ ! "$NGINX_CLIENT_MAX_BODY_SIZE" =~ ^(0|[0-9]+[kKmM]?)$ ]]; then
  printf 'Error: NGINX_CLIENT_MAX_BODY_SIZE must be a number of bytes, optionally followed by k or m\n' >&2
  exit 1
fi

sed "s/__NGINX_CLIENT_MAX_BODY_SIZE__/${NGINX_CLIENT_MAX_BODY_SIZE}/" \
  /etc/nginx/conf.d/grav.conf.template \
  > /etc/nginx/conf.d/grav.conf

ROBOTS_DISALLOW="${ROBOTS_DISALLOW:-false}"
case "${ROBOTS_DISALLOW,,}" in
  true)
    if mountpoint -q /var/www/html/robots.txt; then
      echo "Using mounted custom robots.txt; ignoring ROBOTS_DISALLOW=true"
    else
      install -m 0644 /extras/robots-disallow.txt /var/www/html/robots.txt
    fi
    ;;
  false)
    ;;
  *)
    printf 'Error: ROBOTS_DISALLOW must be true or false\n' >&2
    exit 1
    ;;
esac

GRAV_PLUGIN_UPDATE_ON_STARTUP="${GRAV_PLUGIN_UPDATE_ON_STARTUP:-false}"
validate_boolean() {
  local variable_name="$1"
  local variable_value="$2"

  case "${variable_value,,}" in
    true|false)
      printf '%s' "${variable_value,,}"
      ;;
    *)
      printf 'Error: %s must be true or false\n' "$variable_name" >&2
      exit 1
      ;;
  esac
}

GRAV_PLUGIN_UPDATE_ON_STARTUP="$(validate_boolean \
  GRAV_PLUGIN_UPDATE_ON_STARTUP "$GRAV_PLUGIN_UPDATE_ON_STARTUP")"

validate_cron_number() {
  local value="$1"
  local minimum="$2"
  local maximum="$3"
  local number

  [[ "$value" =~ ^[0-9]{1,2}$ ]] || return 1
  number=$((10#$value))
  (( number >= minimum && number <= maximum ))
}

validate_cron_field() {
  local field="$1"
  local minimum="$2"
  local maximum="$3"
  local item base step start end
  local -a items

  [[ "$field" != ,* && "$field" != *, && "$field" != *,,* ]] || return 1
  IFS=, read -r -a items <<< "$field"

  for item in "${items[@]}"; do
    if [[ "$item" == */* ]]; then
      base="${item%%/*}"
      step="${item#*/}"
      validate_cron_number "$step" 1 "$maximum" || return 1
      [[ "$base" != */* ]] || return 1
    else
      base="$item"
    fi

    if [[ "$base" == '*' ]]; then
      continue
    elif [[ "$base" =~ ^([0-9]{1,2})-([0-9]{1,2})$ ]]; then
      start="${BASH_REMATCH[1]}"
      end="${BASH_REMATCH[2]}"
      validate_cron_number "$start" "$minimum" "$maximum" || return 1
      validate_cron_number "$end" "$minimum" "$maximum" || return 1
      (( 10#$start <= 10#$end )) || return 1
    else
      validate_cron_number "$base" "$minimum" "$maximum" || return 1
    fi
  done
}

validate_cron_schedule() {
  local schedule="$1"
  local index
  local -a fields minimums=(0 0 1 1 0) maximums=(59 23 31 12 7)

  if [[ -z "$schedule" ]]; then
    printf ''
    return
  fi

  if [[ "$schedule" == *$'\n'* || "$schedule" == *$'\r'* ]]; then
    printf 'Error: GRAV_PLUGIN_UPDATE_CRON must be a single five-field cron expression\n' >&2
    return 1
  fi

  read -r -a fields <<< "$schedule"
  if (( ${#fields[@]} != 5 )); then
    printf 'Error: GRAV_PLUGIN_UPDATE_CRON must contain five cron fields\n' >&2
    return 1
  fi

  for index in "${!fields[@]}"; do
    if ! validate_cron_field \
      "${fields[$index]}" "${minimums[$index]}" "${maximums[$index]}"; then
      printf 'Error: invalid field %s in GRAV_PLUGIN_UPDATE_CRON\n' \
        "$((index + 1))" >&2
      return 1
    fi
  done

  printf '%s' "${fields[*]}"
}

GRAV_PLUGIN_UPDATE_CRON="$(validate_cron_schedule \
  "${GRAV_PLUGIN_UPDATE_CRON:-}")"

current_uid="$(id -u www-data)"
current_gid="$(id -g www-data)"
DUID="${DUID:-$current_uid}"
DGID="${DGID:-$current_gid}"

validate_id() {
  local variable_name="$1"
  local value="$2"

  if [[ ! "$value" =~ ^[0-9]+$ ]] || (( ${#value} > 10 )); then
    printf 'Error: %s must be an integer between 1 and 2147483647\n' \
      "$variable_name" >&2
    exit 1
  fi

  value=$((10#$value))
  if (( value == 0 || value > 2147483647 )); then
    printf 'Error: %s must be an integer between 1 and 2147483647\n' \
      "$variable_name" >&2
    exit 1
  fi

  printf '%s' "$value"
}

DUID="$(validate_id DUID "$DUID")"
DGID="$(validate_id DGID "$DGID")"

if [[ "$DUID" != "$current_uid" ]]; then
  uid_owner="$(awk -F: -v uid="$DUID" '$3 == uid { print $1; exit }' /etc/passwd)"
  if [[ -n "$uid_owner" && "$uid_owner" != www-data ]]; then
    printf 'Error: DUID %s is already assigned to %s\n' \
      "$DUID" "$uid_owner" >&2
    exit 1
  fi
fi

if [[ "$DGID" != "$current_gid" ]]; then
  gid_owner="$(awk -F: -v gid="$DGID" '$3 == gid { print $1; exit }' /etc/group)"
  if [[ -n "$gid_owner" && "$gid_owner" != www-data ]]; then
    printf 'Error: DGID %s is already assigned to %s\n' \
      "$DGID" "$gid_owner" >&2
    exit 1
  fi
fi

if [[ "$DGID" != "$current_gid" ]]; then
  groupmod --gid "$DGID" www-data
fi
if [[ "$DUID" != "$current_uid" ]]; then
  # Keep usermod from recursively changing ownership under /var/www.
  usermod --home /nonexistent www-data
fi
usermod --uid "$DUID" --gid www-data www-data
chown www-data:crontab /var/spool/cron/crontabs/www-data

for directory in cache logs tmp backup images assets user; do
  path="/var/www/html/$directory"
  if ! mountpoint -q "$path" \
    && [[ "$(stat -c '%u:%g' "$path")" != "$DUID:$DGID" ]]; then
    chown -R www-data:www-data "$path"
  fi
done

if [[ "$GRAV_PLUGIN_UPDATE_ON_STARTUP" == true ]]; then
  echo "Updating Grav plugins on startup"
  runuser -u www-data -- /bin/bash -c \
    'cd /var/www/html && /usr/bin/php8.4 bin/gpm update --plugins --all-yes'
fi

if [[ -n "$GRAV_PLUGIN_UPDATE_CRON" ]]; then
  {
    crontab -u www-data -l
    printf '%s %s\n' "$GRAV_PLUGIN_UPDATE_CRON" \
      'cd /var/www/html && /usr/bin/php8.4 bin/gpm update --plugins --all-yes >> /var/www/html/logs/plugin-updates.log 2>&1'
  } | crontab -u www-data -
fi

nginx -t
service cron start
service php8.4-fpm start
exec nginx -g 'daemon off;'
